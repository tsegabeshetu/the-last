# Copy to .env and adjust. The demo runs without any of these values.
AEC_ADMIN_TOKEN=aec-demo-admin
AEC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AEC_JAVA_DISPATCH_URL=
AEC_DATA_DIR=./data

# Optional: lets ASAYECH rephrase its reviewed answers.
# OpenAI-compatible endpoint — Gemini works here too:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AEC_ASSISTANT_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AEC_ASSISTANT_MODEL=gpt-4o-mini
