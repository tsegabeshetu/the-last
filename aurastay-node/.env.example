# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false

# Session lifetime in days
SESSION_TTL_DAYS=7

# Where the JSON database and uploaded images are stored (relative to project root)
DATA_DIR=data

# Set to false to hide the demo-account hint on the sign-in page
DEMO_MODE=true

# Optional: allow self-service member registration (disabled by default)
ALLOW_REGISTRATION=false

# Optional: FETAN live AI (OpenAI-compatible chat completions).
# The assistant works fully without these; it falls back to the built-in bilingual guide.
FETAN_AI_API_KEY=
FETAN_AI_BASE_URL=https://api.openai.com/v1
FETAN_AI_MODEL=gpt-4o-mini
